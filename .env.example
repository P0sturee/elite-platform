# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used in e-mails and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret between Supabase (private.config.notify_secret) and /api/notify
NOTIFY_SECRET=

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM="Elite Systems <avisos@elitesystems.online>"

# WhatsApp Cloud API (Meta) — optional; leave empty to skip WhatsApp delivery
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=aviso_plataforma
WHATSAPP_TEMPLATE_LANG=pt_BR
